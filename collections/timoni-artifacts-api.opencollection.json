{
  "opencollection": "1.0.0",
  "info": {
    "name": "Timoni Module Registry Artifacts API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Artifacts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Module Blob",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://ghcr.io/v2/:registry/:module/blobs/:digest",
            "params": [
              {
                "name": "registry",
                "value": "",
                "type": "path"
              },
              {
                "name": "module",
                "value": "",
                "type": "path"
              },
              {
                "name": "digest",
                "value": "",
                "type": "path",
                "description": "Blob digest in format sha256:<hash>"
              }
            ]
          },
          "docs": "Download a specific blob layer of a Timoni module, typically containing CUE definitions, values schemas, and module metadata."
        }
      ]
    }
  ],
  "bundled": true
}