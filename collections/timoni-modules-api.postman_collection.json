                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "module",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "reference",
                  "description": "(Required) Tag (e.g., v1.0.0) or digest (sha256:...)"
