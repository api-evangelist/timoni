          "name": "Get Module Manifest",
          "request": {
            "name": "Get Module Manifest",
            "description": {
              "content": "Retrieve the OCI manifest for a specific Timoni module version. The manifest contains the module metadata, CUE definitions, and layer digests.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                ":registry",
                ":module",
                "manifests",
                ":reference"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
