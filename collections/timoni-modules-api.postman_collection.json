  "info": {
    "_postman_id": "32baa423-ffce-45e5-8122-30d909d94677",
    "name": "Timoni Module Registry Artifacts Modules API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Timoni is a package manager for Kubernetes powered by CUE that provides type-safe alternatives to Helm charts. Timoni modules are distributed as OCI artifacts in container registries. This API describes the OCI registry operations used for module distribution, versioning, and artifact management within the Timoni ecosystem.\n\nContact Support:\n Name: Timoni Documentation",
      "type": "text/plain"
